# ============================================================
# CED Intelligence Platform — environment template
#
# Copy to .env.local for local development, and set the same
# variables in the Vercel project settings for deploys.
#
# NEVER commit real values. .env* is already ignored by
# .gitignore except for this example file.
#
# Every variable here is SERVER-ONLY. None may be given a
# NEXT_PUBLIC_ or VITE_ prefix, and none may appear in a
# vertical's assessment.config.js. Verticals configure a path;
# the server holds the keys.
# ============================================================

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=

# SERVER-ONLY, ELEVATED. Bypasses Row Level Security and can read and write
# every table. It must exist only in the Vercel Function environment. Never
# expose it to browser code, never prefix it with NEXT_PUBLIC_ or VITE_, never
# send it to the client, and never paste it into a vertical's config. If it is
# ever exposed, rotate it in Supabase immediately.
#
# Supabase renamed this key to "secret". PREFER SUPABASE_SECRET_KEY;
# SUPABASE_SERVICE_ROLE_KEY is the legacy name, kept only so projects
# configured before the rename keep working. Set ONE of them, and for a new
# deployment set the secret one. Do not obtain a legacy service_role key.
#
# ALL THREE SERVER SURFACES read this through shared/security/supabase-keys.js:
# api/assessments.mjs, api/analytics.mjs and the staff route. They used to
# disagree — the staff route preferred SUPABASE_SECRET_KEY and the two public
# endpoints read only SUPABASE_SERVICE_ROLE_KEY — so setting just the modern
# variable brought up the authenticated console while assessment capture
# answered 503 not_configured and analytics silently degraded.
#
# A value here that is SET BUT MALFORMED does not fall back to the legacy
# variable. It is refused, and the surfaces fail closed, because a typo that
# silently demotes the deployment to a different key is invisible until the
# day that key is removed.
#
# Required for assessment ingestion, analytics ingestion, and every protected
# staff operation — the queue, a case read, a link, and /session with its
# refresh and signout. NOT required by GET /auth-config, which returns only
# public client configuration.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# SERVER-ONLY, LOW PRIVILEGE. Everything the staff route does with Supabase
# Auth uses this key and only this key:
#
#   · sign in with email and password
#   · list the operator's verified TOTP factors
#   · challenge and verify the second factor
#   · refresh and revoke a session
#   · verify a staff access token on every subsequent request
#
# It grants nothing on its own — every table has RLS enabled and FORCED with no
# policies, and this key holds no execute grant on any function.
#
# It is called "publishable" because it is safe to publish, not because it is
# published here. NOTHING IN THIS REPOSITORY SERVES IT TO A BROWSER. The staff
# console holds no Supabase client and no key of any kind: it talks to
# /api/staff/identity-resolution/..., and the route holds the keys. There is no
# build step here, so putting the Supabase library in the page would have meant
# vendoring a generated bundle or trusting a CDN, and neither belongs in the
# sign-in path of a console that performs permanent attachments.
#
# Supabase renamed this key to "publishable". SUPABASE_ANON_KEY is accepted as
# a legacy fallback. Set ONE of them.
#
# FAILS CLOSED IF CROSSED. A secret key pasted into either of these variables
# is recognised (by the sb_secret_ prefix, or by a legacy JWT whose role is
# service_role) and refused, so the route answers 503 auth_unavailable rather
# than quietly verifying tokens with an elevated credential. The reverse is
# refused too: a publishable key in SUPABASE_SECRET_KEY is not used for RPC.
#
# REQUIRED for the staff console. Without it the staff route answers
# 503 auth_unavailable and nobody can sign in.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=

# ------------------------------------------------------------
# Origin policy
# ------------------------------------------------------------

# Comma-separated exact origins allowed to call /api/assessments.
# Include the scheme, no trailing slash, no path, no wildcards.
# A request with NO Origin header is refused: this endpoint serves browsers
# only. Server-to-server ingestion needs its own authenticated route, which
# does not exist yet.
# Example: https://nails.cedservice.com,https://www.cedservice.com
CED_ALLOWED_ORIGINS=

# ------------------------------------------------------------
# Request and submission windows
# ------------------------------------------------------------

# Maximum accepted request body, in bytes. A completed assessment is ~4 KB.
# Enforced by counting bytes as they arrive, not by trusting Content-Length.
CED_MAX_REQUEST_BYTES=65536

# How long a processed Idempotency-Key is remembered for replay.
CED_IDEMPOTENCY_RETENTION_DAYS=30

# How old a completed assessment may be and still be accepted.
# MUST be at least as long as the browser retry queue's retention (30 days),
# or an assessment completed offline is permanently lost when it finally
# retries. Freshness is NOT an abuse control here — idempotency, rate
# limiting, and the challenge are.
CED_SUBMISSION_MAX_AGE_DAYS=30

# ------------------------------------------------------------
# Challenge verification (F3)
#
# NO PROVIDER HAS BEEN CHOSEN YET. The adapter is provider-neutral and speaks
# the secret/response form-POST shape used by Cloudflare Turnstile and Google
# reCAPTCHA. A production provider MUST be selected and configured before the
# endpoint takes public traffic.
#
# With CED_CHALLENGE_REQUIRED unset or true and no verify URL configured:
#   NODE_ENV=production  -> every submission is refused (fails closed)
#   otherwise            -> an explicit development bypass applies
# ------------------------------------------------------------

# Provider verification endpoint, e.g. https://challenges.cloudflare.com/turnstile/v0/siteverify
CED_CHALLENGE_VERIFY_URL=

# SERVER-ONLY provider secret. Never logged, never returned, never sent to a client.
CED_CHALLENGE_SECRET=

# Default is true. An unset variable must not silently disable the protection.
CED_CHALLENGE_REQUIRED=true

# The action name the token must have been issued for. Guards against a token
# minted for some other form being replayed here.
CED_CHALLENGE_EXPECTED_ACTION=assessment_submit

# ------------------------------------------------------------
# Rate limiting (F4)
# ------------------------------------------------------------

# SERVER-ONLY. Used to derive the pseudonymous HMAC bucket key. Raw IP
# addresses and session ids are never stored — only the keyed digest.
# Rotating this invalidates every historical bucket, which is intended.
# Generate with: openssl rand -hex 32
#
# REQUIRED for every staff route subject to database-backed pre-authentication
# limiting: those routes FAIL CLOSED without it and answer 503
# rate_limit_unavailable. GET /auth-config is the one exception — see the staff
# rate-limiting section below. Leave the value blank here — this file carries
# names, never secrets.
CED_RATE_LIMIT_SECRET=

# Fixed window length and the number of submissions permitted per window,
# per pseudonymous address and per assessment session.
CED_RATE_LIMIT_WINDOW_SECONDS=900
CED_RATE_LIMIT_MAX_REQUESTS=20

# ------------------------------------------------------------
# Connected reviews (SM-1)
#
# How a second review — the Quick Service Mix Review — attaches to the
# Business Record a first review created, WITHOUT the browser ever being
# trusted with a Business Record id.
#
# The endpoint signs an opaque, expiring context with this secret and returns
# it. The browser stores the string and echoes it back; the server verifies
# the signature before anything links. A client-supplied businessId is
# deleted from the payload and never consulted.
#
# With this unset, no context is issued and none can be verified: connected
# reviews simply fall back to ordinary identity resolution. That is a
# degraded experience, never an open door.
# ------------------------------------------------------------

# SERVER-ONLY. Never logged, never returned in an error, never sent to a
# client, and never placed in a vertical's config. Rotating it invalidates
# every outstanding context, which is intended.
# Generate with: openssl rand -hex 32
CED_CONTINUATION_SECRET=

# ------------------------------------------------------------
# Timeout budget (I)
#
# The ordering below must hold, innermost first. A client that gives up
# before the server does abandons requests that were about to succeed:
#
#   challenge (3s) < database (6s) < function budget (15s, vercel.json)
#                                  < client (20s, assessment.config.js)
# ------------------------------------------------------------

CED_CHALLENGE_TIMEOUT_MS=3000
CED_DB_TIMEOUT_MS=6000

# Documented here for reference; the client value actually lives in each
# vertical's assessment.config.js submission.timeoutMs.
CED_CLIENT_TIMEOUT_MS=20000

# ------------------------------------------------------------
# Staff identity-resolution console
#
# The only authenticated surface in this repository. Everything it needs
# beyond the keys above is listed here.
#
# Operators are provisioned deliberately and there is no self-registration.
# See docs/STAFF_IDENTITY_RESOLUTION_OPERATIONS.md for the runbook, including
# how the first operator is created.
# ------------------------------------------------------------

# LOCAL DEVELOPMENT ONLY. Permits the staff route to answer over plain http.
#
# It is NOT sufficient on its own and cannot be used to weaken a deployment:
# the request host must ALSO be a loopback address (localhost, 127.0.0.1, ::1)
# and NODE_ENV must not be "production". Set on a real project it changes
# nothing, because neither of those will hold.
#
# Leave unset everywhere except a developer machine and the browser test
# suite, which serves the page over http.
# CED_ALLOW_INSECURE_STAFF=true

# ---------- staff origin allowlist ----------
#
# Comma-separated, EXACT-MATCHED, no wildcards, no suffix matching, and "null"
# is refused. The same rule the public endpoint applies, from the same shared
# validator (shared/security/origin.js).
#
# LEAVE IT UNSET unless the console is served from a different host than the
# API. Unset, the allowlist is the request's OWN origin and nothing else,
# which is exactly right for a console served same-origin with the route it
# calls, and needs no configuration to be correct.
#
# It is deliberately NOT CED_ALLOWED_ORIGINS. That list is the marketing
# verticals' audience; a vertical has no business calling a staff endpoint,
# and sharing the list would silently widen this one every time a vertical
# launched.
#
# WHY IT IS REQUIRED AT ALL. Every request to this route is checked BEFORE any
# rate limit, body read, Supabase Auth call, operator guard or privileged read.
# Without it, a `fetch` from any page an operator happens to open is a CORS
# *simple* request — there is no preflight to fail — and although the attacker
# cannot read the answer, the request is still counted. A few dozen of them
# lock the operator out of their own console.
#
# Requests carrying a body must also declare Content-Type: application/json
# (a utf-8 charset parameter is allowed). text/plain is what a cross-site
# simple request uses to dodge a preflight, so it is refused with 415.
# CED_STAFF_ALLOWED_ORIGINS=https://staff.example.com

# ---------- staff rate limiting ----------
#
# The staff route shares the rate limiter's MECHANISM with the public endpoint
# — the same CED_RATE_LIMIT_SECRET, the same check_rate_limit function in
# Postgres, the same rule that a raw address is never stored — and shares none
# of its BUDGET. The two derive different bucket keys and cannot consume each
# other's counters, so these numbers move independently of the public ones.
#
# They are separate because the public form is a one-shot surface and the
# console is an interactive one. Working a single case costs three requests:
# the case detail, the resolution, and the queue refetch behind the panel. The
# public budget of 20 per 15 minutes therefore locked an operator out after
# roughly six cases, and the only way to fix that raised the public form's
# budget too.
#
# FOUR PASSES, each with its own bucket. Every request takes the
# pre-authentication pass and then exactly ONE of the other three, so a request
# is never charged twice to one counter and a refusal in one bucket can never
# consume another:
#
#   1. pre-authentication, by address alone, on every request. It runs BEFORE
#      the access token is verified, because verification is an outbound call
#      to Supabase Auth and an unauthenticated caller must not be able to make
#      us issue one per request. Uses the staff window and maximum below.
#   2. sign-in, by address alone, on /session ONLY. The tight one: this is the
#      single staff endpoint an unauthenticated caller can reach, and password
#      guessing is what it would be reached for.
#   3. session maintenance, by address alone, on /session/refresh and
#      /session/signout. NOT credential attempts — both present a token this
#      server issued and neither can be used to guess one.
#   4. authenticated, by address AND by operator UUID, after the token is
#      verified and before the operator guard. Uses the staff window and
#      maximum below.
#
# WHY SIGN-IN IS 30 AND NOT 10. One completed sign-in is TWO posts to /session,
# because the form is two steps: email and password, then the six-digit code.
# Ten therefore bought five sign-ins per address per window — and operators
# share an address whenever they share an office. Ten COMPLETE two-step
# attempts is twenty posts, so thirty leaves room for a mistyped code without
# locking the office out. Thirty password attempts per fifteen minutes per
# address is still nowhere near enough to guess one, and the second factor sits
# behind it regardless.
#
# WHY MAINTENANCE IS SEPARATE. Refresh and sign-out used to share the sign-in
# bucket, so a working console spent the budget its own operator needed to sign
# in again — and because a refused refresh ends the session, the tight bucket
# was ejecting exactly the people it was meant to protect. 60 per 15 minutes
# covers several operators refreshing roughly hourly and signing out, and is
# still bounded.
#
# Defaults: 900 / 240 for the staff passes, 900 / 30 for sign-in,
# 900 / 60 for session maintenance.
# CED_STAFF_RATE_LIMIT_WINDOW_SECONDS=900
# CED_STAFF_RATE_LIMIT_MAX_REQUESTS=240
# CED_STAFF_SIGNIN_RATE_LIMIT_WINDOW_SECONDS=900
# CED_STAFF_SIGNIN_RATE_LIMIT_MAX_REQUESTS=30
# CED_STAFF_SESSION_RATE_LIMIT_WINDOW_SECONDS=900
# CED_STAFF_SESSION_RATE_LIMIT_MAX_REQUESTS=60
#
# The separation lives inside the keyed HMAC input, not in the database's
# `scope` column: rate_limit_buckets.scope keeps the ('address','session')
# check migration 0003 gave it, and the namespace prefixes the value that is
# hashed. Different namespaces therefore derive different bucket_key values and
# land on different rows. No raw address, email, token, session id or operator
# UUID is ever stored — only the HMAC.
#
# REQUIRED FOR EVERY STAFF ROUTE SUBJECT TO DATABASE-BACKED
# PRE-AUTHENTICATION LIMITING. THE LIMITER FAILS CLOSED.
#
# This reverses an earlier note that said a missing secret simply disabled
# rate limiting. It did, and that was the defect: forgetting one variable
# created an unmetered authentication path, silently.
#
# Every rate-limited staff route now refuses when it cannot meter the caller.
# Three conditions, one answer:
#
#   · CED_RATE_LIMIT_SECRET missing or blank  -> reason missing_secret
#   · no usable caller identifier             -> reason missing_identifier
#   · the check_rate_limit call fails or
#     exceeds its timeout                     -> reason rpc_error / timeout
#
# In every case the answer is the same and carries nothing about the caller,
# the configuration or the upstream failure:
#
#   HTTP 503
#   { "ok": false, "code": "rate_limit_unavailable", "message": "…" }
#   Retry-After: 5
#
# The reason is a fixed token in the server log only. The secret, the caller's
# address, request bodies and upstream error bodies are never logged.
#
# THE CALLER IDENTIFIER comes from the first of these headers that carries a
# usable value: x-vercel-forwarded-for, x-real-ip, x-forwarded-for,
# cf-connecting-ip, true-client-ip. Vercel's own header is preferred because
# an intermediary cannot append to it. A request arriving with none of them —
# or with a value that is not address-shaped — is refused, not waved through.
#
# ---------- the one route this does not apply to ----------
#
# GET /api/staff/identity-resolution/auth-config is NOT subject to the
# database-backed pre-authentication limiter, and needs neither
# CED_RATE_LIMIT_SECRET nor an elevated Supabase credential.
#
# It returns only public client configuration — the project origin and the
# publishable key, which Supabase publishes for browser clients. It performs
# no authentication and no privileged database operation: no access token, no
# body, no table, no RPC.
#
# THIS IS NOT A DEVELOPMENT OR PREVIEW BYPASS. It is one method on one path,
# decided identically in every environment; no variable widens or narrows it.
# Everything ahead of the limiter still applies to it — HTTPS, the origin and
# Fetch Metadata gate, the no-body rule, and the method table that answers 405
# with Allow: GET. Misconfiguration still refuses, with the established
# sanitized 503 auth_unavailable.
#
# The reason it is excluded is concrete: while it was metered, a deployment
# holding a project URL and a publishable key and nothing else answered 503
# database_unavailable to the one request whose job is to tell the browser
# which Supabase project to talk to. A limiter whose failure mode is that
# nobody can reach the sign-in page is not protecting the endpoint.
#
# EVERY OTHER STAFF ROUTE IS UNCHANGED and still fails closed on all five
# conditions, including a missing elevated credential. Protected staff
# operations — the queue, a case read, a link, and /session with its refresh
# and signout — still require SUPABASE_SECRET_KEY (preferred) or the legacy
# SUPABASE_SERVICE_ROLE_KEY.

# ---------- staff rate-limit timeout ----------
#
# How long the check_rate_limit call may take before the route gives up and
# returns rate_limit_unavailable. The pre-authentication pass runs on every
# request, so an unbounded one could consume the platform's whole function
# budget and answer 504 with no body at all.
#
# Default 2000 ms. Values are clamped to 250–4000 ms: below that a healthy
# database would be refused, and above it a few passes could approach the
# function budget. A missing, blank or unparseable value uses the default.
# CED_RATE_LIMIT_TIMEOUT_MS=2000

# ------------------------------------------------------------
# BI → Sales: the CRM boundary (0009/0010/0011)
#
# Two surfaces:
#   POST /api/sales/promote  — authenticated, operator-only. Turns a
#                              qualified handoff into a CRM contact, and
#                              conditionally an opportunity.
#   POST /api/webhooks/ghl   — unauthenticated by necessity; the Ed25519
#                              signature is the credential.
#
# GHL owns communications, sales execution, current opportunity state and
# Won/Lost. Supabase owns identity, evidence, qualification, links and
# history. Nothing here may turn Supabase into a second CRM, and no value
# below makes Supabase authoritative for the live pipeline stage.
# ------------------------------------------------------------

# SERVER-ONLY. HighLevel Private Integration token for the CED Service
# sub-account (Settings > Private Integrations). It can read and write
# contacts and opportunities, so it is a credential in the same class as the
# elevated Supabase key: never in browser code, never prefixed, never logged.
#
# GHL_API_TOKEN is preferred. GHL_PI_TOKEN is accepted as a fallback ONLY
# when the preferred variable is unset, because the infrastructure scripts in
# the CED-Service repository already use that name for the same token —
# following the §14 precedent of one preferred name and one legacy fallback,
# never two places that read a credential independently.
GHL_API_TOKEN=
GHL_PI_TOKEN=

# The sub-account location. Every contact, opportunity and webhook is scoped
# to it, and the webhook receiver REJECTS a delivery whose locationId does not
# match — a cross-location delivery is either a misconfiguration or someone
# else's data, and neither may write history here.
GHL_LOCATION_ID=

# The pipeline researched outbound opportunities are created in. There is
# exactly one and a second must not be created.
GHL_PIPELINE_ID=

# The stage a RESEARCHED OUTBOUND opportunity starts in — "Qualified — Not
# Contacted". Inbound entry into "New Inquiry" belongs to GHL's own workflows
# and is never set from here, which is what keeps the two lead sources
# distinguishable in the pipeline.
GHL_STAGE_QUALIFIED_NOT_CONTACTED=

# Contact custom field ids, addressed by ID and never by fieldKey: a key can
# be renamed in the CRM UI, an id cannot.
#
#   CED Business ID — the canonical Supabase business_id. This is what makes
#     a contact recoverable when its link row is lost, and it is the first
#     thing the promotion route searches on before it creates anything.
#   Lead Focus — the existing field, reused rather than duplicated.
GHL_FIELD_CED_BUSINESS_ID=
GHL_FIELD_LEAD_FOCUS=

# OPTIONAL. Overrides the pinned HighLevel Ed25519 public key used to verify
# X-GHL-Signature. The default is HighLevel's own published key and is
# correct for production; this exists so the test suite can sign deliveries
# with a key it controls.
#
# THERE IS NO VARIABLE THAT DISABLES VERIFICATION. Setting this to an
# invalid key fails every delivery closed rather than opening the endpoint.
# The deprecated RSA X-WH-Signature header is not accepted at all.
# GHL_WEBHOOK_PUBLIC_KEY=

# OPTIONAL. API base and version, for pinning or for a test double.
# GHL_API_BASE=https://services.leadconnectorhq.com
# GHL_API_VERSION=2021-07-28

# LOCAL DEVELOPMENT ONLY. Permits the two sales surfaces to answer over plain
# http. Same three-condition rule as CED_ALLOW_INSECURE_STAFF and it is NOT
# sufficient on its own: the host must also be loopback AND NODE_ENV must not
# be "production".
# CED_ALLOW_INSECURE_SALES=true

# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------

# error | warn | info | debug
# Logs carry identifiers, outcomes, and a correlation id only — never contact
# details, answers, request bodies, tokens, or secrets.
CED_LOG_LEVEL=info

# Set by the platform. Governs whether the challenge adapter's development
# bypass is available; it is unavailable when this is "production".
# NODE_ENV=production
