# ============================================================
# CED Intelligence Platform — environment template
#
# Copy to .env.local for local development, and set the same
# variables in the Vercel project settings for deploys.
#
# NEVER commit real values. .env* is already ignored by
# .gitignore except for this example file.
#
# Every variable here is SERVER-ONLY. None may be given a
# NEXT_PUBLIC_ or VITE_ prefix, and none may appear in a
# vertical's assessment.config.js. Verticals configure a path;
# the server holds the keys.
# ============================================================

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=

# SERVER-ONLY. The service role key bypasses Row Level Security and can read
# and write every table. It must exist only in the Vercel Function environment.
# Never expose it to browser code, never prefix it with NEXT_PUBLIC_ or VITE_,
# never send it to the client, and never paste it into a vertical's config.
# If it is ever exposed, rotate it in Supabase immediately.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------
# Origin policy
# ------------------------------------------------------------

# Comma-separated exact origins allowed to call /api/assessments.
# Include the scheme, no trailing slash, no path, no wildcards.
# A request with NO Origin header is refused: this endpoint serves browsers
# only. Server-to-server ingestion needs its own authenticated route, which
# does not exist yet.
# Example: https://nails.cedservice.com,https://www.cedservice.com
CED_ALLOWED_ORIGINS=

# ------------------------------------------------------------
# Request and submission windows
# ------------------------------------------------------------

# Maximum accepted request body, in bytes. A completed assessment is ~4 KB.
# Enforced by counting bytes as they arrive, not by trusting Content-Length.
CED_MAX_REQUEST_BYTES=65536

# How long a processed Idempotency-Key is remembered for replay.
CED_IDEMPOTENCY_RETENTION_DAYS=30

# How old a completed assessment may be and still be accepted.
# MUST be at least as long as the browser retry queue's retention (30 days),
# or an assessment completed offline is permanently lost when it finally
# retries. Freshness is NOT an abuse control here — idempotency, rate
# limiting, and the challenge are.
CED_SUBMISSION_MAX_AGE_DAYS=30

# ------------------------------------------------------------
# Challenge verification (F3)
#
# NO PROVIDER HAS BEEN CHOSEN YET. The adapter is provider-neutral and speaks
# the secret/response form-POST shape used by Cloudflare Turnstile and Google
# reCAPTCHA. A production provider MUST be selected and configured before the
# endpoint takes public traffic.
#
# With CED_CHALLENGE_REQUIRED unset or true and no verify URL configured:
#   NODE_ENV=production  -> every submission is refused (fails closed)
#   otherwise            -> an explicit development bypass applies
# ------------------------------------------------------------

# Provider verification endpoint, e.g. https://challenges.cloudflare.com/turnstile/v0/siteverify
CED_CHALLENGE_VERIFY_URL=

# SERVER-ONLY provider secret. Never logged, never returned, never sent to a client.
CED_CHALLENGE_SECRET=

# Default is true. An unset variable must not silently disable the protection.
CED_CHALLENGE_REQUIRED=true

# The action name the token must have been issued for. Guards against a token
# minted for some other form being replayed here.
CED_CHALLENGE_EXPECTED_ACTION=assessment_submit

# ------------------------------------------------------------
# Rate limiting (F4)
# ------------------------------------------------------------

# SERVER-ONLY. Used to derive the pseudonymous HMAC bucket key. Raw IP
# addresses and session ids are never stored — only the keyed digest.
# Rotating this invalidates every historical bucket, which is intended.
# Generate with: openssl rand -hex 32
CED_RATE_LIMIT_SECRET=

# Fixed window length and the number of submissions permitted per window,
# per pseudonymous address and per assessment session.
CED_RATE_LIMIT_WINDOW_SECONDS=900
CED_RATE_LIMIT_MAX_REQUESTS=20

# ------------------------------------------------------------
# Timeout budget (I)
#
# The ordering below must hold, innermost first. A client that gives up
# before the server does abandons requests that were about to succeed:
#
#   challenge (3s) < database (6s) < function budget (15s, vercel.json)
#                                  < client (20s, assessment.config.js)
# ------------------------------------------------------------

CED_CHALLENGE_TIMEOUT_MS=3000
CED_DB_TIMEOUT_MS=6000

# Documented here for reference; the client value actually lives in each
# vertical's assessment.config.js submission.timeoutMs.
CED_CLIENT_TIMEOUT_MS=20000

# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------

# error | warn | info | debug
# Logs carry identifiers, outcomes, and a correlation id only — never contact
# details, answers, request bodies, tokens, or secrets.
CED_LOG_LEVEL=info

# Set by the platform. Governs whether the challenge adapter's development
# bypass is available; it is unavailable when this is "production".
# NODE_ENV=production
